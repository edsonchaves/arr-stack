# ============================================================
# SYSTEM
# ============================================================

# Your user and group IDs — run: id -u  and  id -g
USER_ID=1000
GROUP_ID=1000

TIMEZONE=Europe/Berlin

# Where service config files are stored (persists all UI settings)
CONFIG_ROOT=/path/to/nas-server/config

# Where your media and torrents live
DATA_ROOT=/mnt/data

# ============================================================
# MULLVAD VPN (WireGuard)
# ============================================================
# How to get these values:
#   1. Go to mullvad.net → Account → WireGuard keys
#   2. Click "Generate key"
#   3. Copy the private key and assigned IP address
#
# MULLVAD_CITY examples: "Frankfurt", "Amsterdam", "Stockholm"

MULLVAD_PRIVATE_KEY=YOUR_MULLVAD_WIREGUARD_PRIVATE_KEY
MULLVAD_ADDRESSES=YOUR_MULLVAD_ASSIGNED_IP/32
MULLVAD_CITY=YOUR_CITY

# ============================================================
# WG-EASY (Remote access VPN server)
# ============================================================
# Your machine's local network IP (e.g. 192.168.1.100)
# Run: hostname -I | awk '{print $1}'
SERVER_LAN_IP=YOUR_LAN_IP

# Bcrypt hash of your WG-Easy web UI password
# Generate with: docker run ghcr.io/wg-easy/wg-easy wgpw YOUR_PASSWORD_HERE
WGEASY_PASSWORD_HASH=YOUR_BCRYPT_HASH

# ============================================================
# JELLYSTAT DATABASE
# ============================================================
# Choose any secure passwords/secrets
JELLYSTAT_DB_PASSWORD=YOUR_SECURE_PASSWORD
JELLYSTAT_JWT_SECRET=YOUR_LONG_RANDOM_SECRET

# ============================================================
# API KEYS
# Fill these in after the stack is running for the first time.
# Each app: Settings → General → API Key
# These are used by Homepage widgets and inter-service connections.
# ============================================================

SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
BAZARR_API_KEY=
PROWLARR_API_KEY=
JELLYSEERR_API_KEY=
JELLYFIN_API_KEY=
AUTOBRR_API_KEY=

# ============================================================
# SERVICE CREDENTIALS
# ============================================================

# qBittorrent web UI login (set your password after first login)
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=YOUR_QBITTORRENT_PASSWORD

# Calibre-Web login
CALIBRE_USERNAME=admin
CALIBRE_PASSWORD=

# ============================================================
# HOMEPAGE DASHBOARD
# ============================================================

HOMEPAGE_VAR_TITLE=NAS
HOMEPAGE_VAR_SEARCH_PROVIDER=google
HOMEPAGE_VAR_HEADER_STYLE=clean

# Optional weather widget — leave blank to disable
HOMEPAGE_VAR_WEATHER_CITY=YOUR_CITY
HOMEPAGE_VAR_WEATHER_LAT=
HOMEPAGE_VAR_WEATHER_LONG=
HOMEPAGE_VAR_WEATHER_UNIT=metric
